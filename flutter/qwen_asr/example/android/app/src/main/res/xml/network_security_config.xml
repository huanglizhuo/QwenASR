<?xml version="1.0" encoding="utf-8"?>
<!--
  Production model downloads use HTTPS (the default HuggingFace base URL), so
  cleartext stays disabled globally. Cleartext is permitted ONLY for loopback
  addresses so the "override base URL" advanced setting can point at a local
  `python3 -m http.server` during development/testing without weakening the
  app's transport security for any real host.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
